# ATENCION: este fichero es solo una PLANTILLA. La app SOLO lee ".env"
# (backend/app/config/settings.py), nunca ".env.example". Si editas
# directamente este fichero, tus cambios (API keys incluidas) NUNCA se
# cargan y no vas a ver ningun error avisandote.
#
# Paso obligatorio: copia este archivo a .env y edita ESE:
#   cp .env.example .env
#
# El proyecto arranca con SQLite si DATABASE_URL no se define (util para
# desarrollo rapido); usa Postgres en docker-compose y en produccion.

APP_ENV=development
LOG_LEVEL=INFO

# --- Puertos de Docker Compose (opcional) ---
# Solo hace falta si el 8000/3000 de tu maquina ya estan ocupados (p.ej. un
# 'uvicorn' suelto de una prueba anterior). Si cambias BACKEND_PORT,
# actualiza tambien NEXT_PUBLIC_API_URL al mismo puerto y reconstruye con
# 'docker compose build frontend' (se hornea en el build, no en el arranque).
# BACKEND_PORT=8001
# FRONTEND_PORT=3001
# NEXT_PUBLIC_API_URL=http://localhost:8001

# --- Base de datos ---
# Postgres (docker-compose): postgresql+psycopg://football:football@postgres:5432/football_edge
# SQLite local (sin infra): sqlite:///./data/processed/football_edge.db
DATABASE_URL=sqlite:///./data/processed/football_edge.db

# --- Redis (opcional, cache de ingestion/odds) ---
REDIS_URL=

# --- Fuentes de datos ---
# football-data.co.uk: CSV publicos, sin API key, sin limite documentado.
# Fuente principal del MVP (resultados + odds cerradas de varias casas).
FOOTBALL_DATA_CO_UK_ENABLED=true

# understat.com: xG por partido via scraping ligero de JSON embebido.
# Pendiente de validacion de estabilidad -> adapter creado pero deshabilitado
# por defecto (ver docs/data_sources.md).
UNDERSTAT_ENABLED=false

# FBref (Sports Reference): estadisticas avanzadas via tablas HTML.
# Requiere respetar rate limits estrictos. Deshabilitado por defecto.
FBREF_ENABLED=false

# API-Football (api-football.com o via RapidAPI): unica fuente de cuotas
# REALES de tarjetas/corners del proyecto (The Odds API no ofrece esos
# mercados en ningun plan, ver docs/data_sources.md). Plan gratuito: 100
# requests/dia — por eso solo se piden cuotas de la JORNADA ACTUAL, nunca
# la temporada completa.
#   1. Registrate en https://www.api-football.com/ (o via RapidAPI:
#      https://rapidapi.com/api-sports/api/api-football)
#   2. Copia la API key que te dan
#   3. Pon API_FOOTBALL_ENABLED=true y API_FOOTBALL_KEY=<tu-key> abajo
#   4. Si tu key es de RapidAPI (no directamente de api-football.com),
#      pon ademas API_FOOTBALL_USE_RAPIDAPI=true
#   5. Ejecuta `football-edge update-secondary-odds` (o `refresh`, que ya lo incluye)
API_FOOTBALL_ENABLED=false
API_FOOTBALL_KEY=
API_FOOTBALL_USE_RAPIDAPI=false

# The Odds API (cuotas REALES de partidos futuros, https://the-odds-api.com).
# Sin esto activado, el sistema muestra predicciones para partidos futuros
# pero SIN market_probability/edge (no hay con que comparar el modelo).
# Registro gratuito (plan free = 500 requests/mes, mas que suficiente para
# refrescar las 5 ligas del MVP varias veces al dia):
#   1. Crea una cuenta en https://the-odds-api.com/#get-access (gratis, sin tarjeta)
#   2. Copia la API key que te dan
#   3. Pon ODDS_API_ENABLED=true y ODDS_API_KEY=<tu-key> abajo
#   4. Ejecuta `football-edge update-odds` (o `football-edge refresh`, que ya lo incluye)
ODDS_API_ENABLED=false
ODDS_API_KEY=
# Opcional: tambien trae Over/Under a linea 1.5 (alternate_totals) y
# Ambos Marcan (btts). OJO: estos mercados solo se pueden pedir por
# EVENTO (1 request extra por partido en cartel, no por liga), asi que
# activarlo consume cuota bastante mas rapido que solo h2h/totals -- si
# refrescas varias veces al dia con las 5 ligas, puedes agotar el plan
# gratuito de 500 req/mes antes de fin de mes. Desactivado por defecto.
ODDS_API_FETCH_ADDITIONAL_MARKETS=false

# --- Modelos ---
MODEL_ARTIFACTS_DIR=models/artifacts
RANDOM_SEED=42

# --- Agente Jarvis (POST /agent/chat, backend/app/agent/) ---
# Desactivado por defecto a proposito: sin AGENT_SHARED_SECRET puesto (y,
# si usas el proveedor "anthropic", sin ANTHROPIC_API_KEY), el endpoint
# responde 503 en vez de quedar abierto.
#
# DOS FORMAS DE PAGAR EL LLM -- elige UNA via AGENT_LLM_PROVIDER:
#
# Opcion A) AGENT_LLM_PROVIDER=anthropic (por defecto)
#   API de Anthropic facturada por token, aparte de cualquier suscripcion.
#   1. Crea una API key en https://console.anthropic.com/
#   2. Ponla en ANTHROPIC_API_KEY abajo
#
# Opcion B) AGENT_LLM_PROVIDER=claude_code
#   Usa el motor de Claude Code con tu suscripcion Claude Pro/Max (sin
#   pagar API aparte) -- pero sujeto a los limites de uso de tu plan, que
#   estan pensados para uso interactivo tuyo, no para un servicio en
#   segundo plano con mucho trafico. El Dockerfile del backend YA instala
#   el CLI `claude`; solo falta autenticarlo:
#
#   - venv local (sin Docker): `claude login` una vez en esa maquina (abre
#     el navegador, queda logueado en tu ~/.claude). NO hace falta ninguna
#     variable de entorno extra.
#   - Docker (o cualquier entorno sin terminal interactiva): un `claude
#     login` normal no funciona dentro del contenedor. En su lugar:
#       1. En TU maquina (donde SI tienes `claude` logueado), ejecuta:
#            claude setup-token
#          Te da un token de larga duracion ligado a tu suscripcion.
#       2. Ponlo aqui abajo en CLAUDE_CODE_OAUTH_TOKEN -- docker-compose ya
#          inyecta tu .env entero a los contenedores backend/scheduler
#          (ver env_file en docker-compose.yml), asi que el CLI dentro del
#          contenedor lo coge solo, sin login interactivo.
#   NO hace falta ANTHROPIC_API_KEY con esta opcion.
CLAUDE_CODE_OAUTH_TOKEN=
#
# En ambos casos, ademas:
#   - Inventa un secreto largo y aleatorio para AGENT_SHARED_SECRET (por
#     ejemplo: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
#     y guardalo tambien en el frontend (variable de entorno, NUNCA
#     hardcodeado) para que lo mande en la cabecera X-Agent-Key
#   - Pon AGENT_ENABLED=true
AGENT_ENABLED=false
AGENT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_SHARED_SECRET=
# claude-haiku-4-5 por defecto: barato, de sobra para decidir que
# herramienta llamar. Sube a un modelo mas potente solo si notas que se
# equivoca eligiendo tools o resumiendo mal los datos. Con
# AGENT_LLM_PROVIDER=claude_code el coste ya no depende del modelo (va
# incluido en tu suscripcion), pero el modelo elegido si sigue afectando a
# la calidad de las respuestas.
AGENT_LLM_MODEL=claude-haiku-4-5-20251001

# --- Alertas proactivas de Jarvis (agent/alerts.py, se generan cada hora ---
# junto al settlement, via 'football-edge evaluate') ---
# Desactivadas por defecto: no generan nada hasta que las actives. De
# momento SOLO se guardan en la base de datos (tool get_active_alerts) --
# no hay envio a email/Telegram/push todavia, eso es trabajo futuro.
AGENT_ALERTS_ENABLED=false
AGENT_ALERT_MIN_EDGE_PP=5.0
# HIGH_DATA_SUPPORT | MEDIUM_DATA_SUPPORT | LOW_DATA_SUPPORT
AGENT_ALERT_MIN_TIER=MEDIUM_DATA_SUPPORT
# Lista JSON de competition_code a vigilar, ej ["premier_league","laliga"].
# Vacio ([]) = todas las conocidas.
AGENT_ALERT_LEAGUES=[]

# --- Voz de Jarvis (POST /agent/transcribe, backend/app/agent/transcription.py, Fase 7) ---
# El reconocimiento de voz NATIVO del navegador (Web Speech API) NO es
# local pese a las apariencias: manda el audio a un servidor de Google con
# una clave API que Chrome trae de fabrica -- Brave (y otros Chromium
# centrados en privacidad) la elimina a proposito, asi que falla siempre
# con "error de red" (bug real confirmado por un usuario). Por eso el
# microfono de Jarvis graba el audio en el navegador y lo manda a ESTE
# backend, donde un modelo Whisper local lo transcribe -- sin API key de
# pago ni depender de ningun servicio externo. No necesita activarse aparte:
# usa el mismo AGENT_ENABLED/AGENT_SHARED_SECRET de arriba.
# Tamanho del modelo: tiny|base|small|medium|large-v3 (mas grande = mas
# preciso y mas lento en CPU). "base" es buen punto de partida para
# espanhol conversacional corto en un servidor sin GPU.
WHISPER_MODEL_SIZE=base
# int8 es mucho mas rapido en CPU que float32 con perdida de precision
# minima para clips cortos -- cambia a "float32" solo si notas
# transcripciones incorrectas.
WHISPER_COMPUTE_TYPE=int8
